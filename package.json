{
  "name": "agent-hub",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first CLI for orchestrating coding agents.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-hub": "./apps/cli/dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "desktop:build": "pnpm --filter desktop build",
    "desktop:dist:mac": "bash scripts/build-macos-dmg.sh",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json && tsc -b apps/cli/tsconfig.tui-ink.json --pretty false && pnpm --filter desktop typecheck",
    "test": "tsc -b apps/cli/tsconfig.tui-ink.json --pretty false && vitest run",
    "test:coverage": "tsc -b apps/cli/tsconfig.tui-ink.json --pretty false && vitest run --coverage",
    "coverage:diff": "node scripts/check-diff-coverage.mjs",
    "lint": "tsc --noEmit --pretty false -p tsconfig.json && tsc -b apps/cli/tsconfig.tui-ink.json --pretty false && pnpm --filter desktop lint"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "1.6.0",
    "pnpm": "10.10.0",
    "typescript": "5.7.2",
    "vitest": "1.6.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "electron"
    ]
  },
  "packageManager": "pnpm@10.10.0"
}
