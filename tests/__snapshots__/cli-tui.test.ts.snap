exports[`CLI TUI command > renders context-read failures with CLI recovery commands > context read failure recovery 1`] = `
"Agent Hub | project_broken | no-thread
agent @fake | ctx runtime_injection | iter 0 | risk unknown
[Work] Graph Runs Review Tasks Memory Help
! failed to read TUI context: database read failed
! recovery: agent-hub project list
! recovery: agent-hub rooms list --project-id project_broken
! recovery: agent-hub tui --help

== Runs ==  0                                                |  == RoleCalls ==
  No runs in the current context.                            |    none | loop stop terminal | pending 0
                                                             |
== Review ==                                                 |  == Transcript ==
TUI context unavailable                                      |    No messages in the current context.
  The current local context could not be read.               |
  latest failed to read TUI context: database read failed    |
  commands:                                                  |
    agent-hub project list                                   |
    agent-hub rooms list --project-id project_broken         |
    agent-hub tui --help                                     |

tab focus | enter review | : palette | c continue | p command | ? help | x exit
> @fake prompt
"
`;

exports[`CLI TUI command > renders missing registration recovery instead of failing launch > missing registration recovery 1`] = `
"Agent Hub | unregistered | no-thread
agent @fake | ctx runtime_injection | iter 0 | risk unknown
[Work] Graph Runs Review Tasks Memory Help
! project root /tmp/unregistered-tui-project is not registered
! recovery: agent-hub project add --name <name> --root /tmp/unregistered-tui-project

== Runs ==  0                                                |  == RoleCalls ==
  No runs in the current context.                            |    none | loop stop terminal | pending 0
                                                             |
== Review ==                                                 |  == Transcript ==
No current context                                           |    No messages in the current context.
  No local review evidence is available yet.                 |

tab focus | enter review | : palette | c continue | p command | ? help | x exit
> @fake prompt
"
`;
