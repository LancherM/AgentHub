// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CLI TUI command > keeps narrow empty workbench output focused on runs before graph state > narrow empty workbench 1`] = `
"Agent Hub | unregistered | no-thread
agent @codex | ctx runtime_injection | iter 0 | risk unknown
[Work] Graph Runs Review Tasks Memory Help

== Runs ==  0
  No runs in the current context.

== Review ==
No current context
  No local review evidence is available yet.

== RoleCalls ==
  none | loop stop terminal | pending 0

== Transcript ==
  No messages in the current context.

tab focus | enter review | : palette | c continue | p command | ? help | x ...
> @codex prompt
"
`;

exports[`CLI TUI command > keeps wide and narrow terminal render snapshots stable > narrow command palette 1`] = `
"Agent Hub | TUI Project | #review
agent @agent | ctx runtime_injection | iter 0/4 | risk unknown
[Work] Graph Runs Review Tasks Memory Help

== Command Palette ==
  Current context
    focus work
    command agent-hub role-calls show call_parent
  Runs
    agent-hub runs show run_1
    agent-hub runs diff run_1 --stat
    agent-hub risks show run_1
  RoleCalls
    agent-hub role-calls show call_parent
  Review
    agent-hub role-calls show call_child
  Memory
    agent-hub memory list --project-id project_1
    agent-hub memory approve <memory-id>
    agent-hub memory reject <memory-id>
  Keys
    : close palette
    p print focused command
    ctrl+j submit composer

tab focus | enter review | : palette | c continue | p command | ?...
> @agent prompt
"
`;

